# ============================================================
# AvalancheTrust — root environment template
# Copy the relevant sections into:
#   frontend/.env.local   (NEXT_PUBLIC_* only)
#   contracts/.env        (deployer secrets)
#   backend/.env          (API + database)
# NEVER commit real values. `.env*` is git-ignored.
# ============================================================

# --- Frontend (public) ---
NEXT_PUBLIC_CHAIN_ID=43113
NEXT_PUBLIC_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_CONTRACT_DEPLOY_BLOCK=0
NEXT_PUBLIC_EXPLORER_URL=https://testnet.snowtrace.io
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_API_URL=

# --- WalletConnect (alias kept for compatibility with older docs) ---
WALLETCONNECT_PROJECT_ID=

# --- Backend ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/avalanchetrust?schema=public

# --- Contracts / deployment (secret) ---
PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=
ADMIN_ADDRESS=0x7E7D78a6692b00C0c5c79431d1Af704c6fCadb19
ARBITRATOR_ADDRESS=0x7E7D78a6692b00C0c5c79431d1Af704c6fCadb19
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
SNOWTRACE_API_KEY=verifyContract
