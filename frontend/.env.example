# ---- Frontend (public, embedded in the browser bundle) ----
# 43113 = Avalanche Fuji Testnet, 43114 = Avalanche C-Chain Mainnet
NEXT_PUBLIC_CHAIN_ID=43113
NEXT_PUBLIC_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
NEXT_PUBLIC_CONTRACT_ADDRESS=
# Block number the contract was deployed at (speeds up event scans). 0 = scan from genesis.
NEXT_PUBLIC_CONTRACT_DEPLOY_BLOCK=0
NEXT_PUBLIC_EXPLORER_URL=https://testnet.snowtrace.io
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: enables WalletConnect wallets. Get one at https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional: off-chain metadata API (backend/). Leave empty to keep documents in the browser only.
NEXT_PUBLIC_API_URL=
# Development only: adds a "Local Dev Wallet" connector backed by Anvil accounts (ignored in production builds)
NEXT_PUBLIC_ENABLE_DEV_WALLET=false
